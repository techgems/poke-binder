<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PokeBinder</title>
    <pines-css />

    @* Admin pages post with htmx rather than reloading themselves. Pinned, and the same version
       _BinderLayout carries -- an unattended major bump would land silently on both. Alpine
       comes from <pines-scripts /> at the foot of the page, which is late enough for Alpine and
       too late for htmx, so htmx is loaded here. *@
    <script src="https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js"
            integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+"
            crossorigin="anonymous"></script>
    <link rel="stylesheet" href="~/css/site.tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PokeBinder.styles.css" asp-append-version="true" />
</head>
<body class="bg-white antialiased">

    @*
        The bar is written out here rather than taken from <pines-navbar>, and the reason is the
        brand. Pines' navbar hardcodes its own logo in a desktop-only <a>, and the one slot near it
        -- logo-area -- renders inside the lg:hidden sidebar toggle, so a brand put there replaces
        the toggle's icon on phones and shows nothing at all on a desktop. Everything else about
        this bar is Pines' own markup, geometry included: h-16 against the content's mt-16, and the
        same toggle calling the same Alpine store <pines-sidebar> listens to.
    *@
    <header class="fixed top-0 z-40 flex h-16 w-full items-center justify-center border-b border-stone-200/20 bg-white/90 backdrop-blur-md">
        <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-4 2xl:px-0">

            <div class="relative z-10 flex w-auto items-center">

                @* Phones only: the sidebar is a drawer there, and this is what opens it. *@
                <button x-data
                        @@click="$store.pinesLayout.toggleSidebar()"
                        class="mr-3 flex h-8 w-8 items-center justify-center rounded-md border border-neutral-200 text-neutral-800 hover:bg-neutral-100 hover:text-black active:bg-white lg:hidden"
                        type="button"
                        aria-label="Toggle sidebar">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2.74902 6.75C2.74902 5.09315 4.09217 3.75 5.74902 3.75H18.2507C19.9075 3.75 21.2507 5.09315 21.2507 6.75V17.25C21.2507 18.9069 19.9075 20.25 18.2507 20.25H5.74902C4.09217 20.25 2.74902 18.9069 2.74902 17.25V6.75Z" />
                            <path d="M13.75 3.75V20.25" />
                            <path d="M16.75 7.75L18.25 7.75" />
                            <path d="M16.75 11L18.25 11" />
                            <path d="M16.75 14.25L18.25 14.25" />
                        </g>
                    </svg>
                </button>

                @* Still a link home, which is what the logo it replaces was. *@
                <a asp-page="/Index" class="text-xl font-bold text-black no-underline">
                    PokeBinder <strong class="font-extrabold">Admin</strong>
                </a>
            </div>

            <div class="relative">
                <partial name="_LoginPartial" />
            </div>
        </div>
    </header>

    @* Page body: sidebar + main content *@
    <div class="relative flex items-start min-h-screen px-4 pt-0 pb-0 mx-auto mt-16 max-w-7xl">

        @* Mobile overlay to close sidebar *@
        <pines-backdrop-blur></pines-backdrop-blur>

        @* Left sidebar *@
        <pines-sidebar>
            <pines-sidebar-section section-name="Binders">
                <pines-sidebar-link asp-page="/Components/my-binders">My Binders</pines-sidebar-link>
            </pines-sidebar-section>
            <pines-sidebar-section section-name="Card catalog">
                <pines-sidebar-link asp-page="/Admin/FilterCache">Filter cache</pines-sidebar-link>
            </pines-sidebar-section>
        </pines-sidebar>

        @* Main content area — offset by sidebar width on large screens *@
        <main role="main" class="flex-1 w-full min-w-0 pl-0 lg:pl-63 pb-16 pt-5">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
    <pines-scripts />
    <render-static-scripts />

    
</body>
</html>
