@using TechGems.PinesUI.Views.Components.PinesNavbar
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PokeBinder</title>
    <pines-css />

    @* Admin pages post with htmx rather than reloading themselves. Pinned, and the same version
       _BinderLayout carries -- an unattended major bump would land silently on both. Alpine
       comes from <pines-scripts /> at the foot of the page, which is late enough for Alpine and
       too late for htmx, so htmx is loaded here. *@
    <script src="https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js"
            integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+"
            crossorigin="anonymous"></script>
    <link rel="stylesheet" href="~/css/site.tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PokeBinder.styles.css" asp-append-version="true" />
</head>
<body class="bg-white antialiased">

    @* Slot names come from the component's own constants rather than the strings behind them --
       PinesNavbar.LogoSlot is what RenderSlot is called with, so a rename in the library shows up
       here as a compile error instead of as an empty bar. *@
    <pines-navbar home-route="/">
        <slot name="@PinesNavbar.LogoSlot">
            <span class="text-xl font-bold whitespace-nowrap">PokeBinder <strong class="font-extrabold">Admin</strong></span>
        </slot>
        <slot name="@PinesNavbar.UserAreaSlot">
            <partial name="_LoginPartial" />
        </slot>
    </pines-navbar>

    @* Page body: sidebar + main content *@
    <div class="relative flex items-start min-h-screen px-4 pt-0 pb-0 mx-auto mt-16 max-w-7xl">

        @* Mobile overlay to close sidebar *@
        <pines-backdrop-blur></pines-backdrop-blur>

        @* Left sidebar *@
        <pines-sidebar>
            <pines-sidebar-section section-name="Binders">
                <pines-sidebar-link asp-page="/Components/my-binders">My Binders</pines-sidebar-link>
            </pines-sidebar-section>
            <pines-sidebar-section section-name="Card catalog">
                <pines-sidebar-link asp-page="/Admin/FilterCache">Filter cache</pines-sidebar-link>
            </pines-sidebar-section>
        </pines-sidebar>

        @* Main content area — offset by sidebar width on large screens *@
        <main role="main" class="flex-1 w-full min-w-0 pl-0 lg:pl-63 pb-16 pt-5">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
    <pines-scripts />
    <render-static-scripts />

    
</body>
</html>
