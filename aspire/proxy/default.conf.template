# pokebinder-proxy: the local stand-in for the nginx on the EC2, in front of the app.
#
# A template, not a finished config: the nginx image runs envsubst over /etc/nginx/templates on
# start, and the AppHost sets the variables below. Only those are substituted
# (NGINX_ENVSUBST_FILTER), so nginx's own $variables pass through untouched:
#
#   APP_ORIGIN         wherever the app is listening
#   TLS_CERT, TLS_KEY  the ASP.NET Core dev certificate, as PEM files Aspire puts in the container
#   HTTPS_PORT         the host port HTTPS is published on, for the redirect
#
# TLS ends here, as it will on the EC2; the app behind it only ever speaks plain HTTP. Requests are
# logged to stdout by the image's default access_log, which is what lands in the Aspire dashboard.

# Plain HTTP only redirects. Nothing is served over it, so a link that drops the scheme still ends
# up on HTTPS rather than on a page whose cookie the browser will not send back.
server {
    listen 80;
    server_name pokebinder.dev.localhost;

    return 301 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    # The dev certificate covers *.dev.localhost but not *.localhost, hence the extra label.
    server_name pokebinder.dev.localhost;

    ssl_certificate ${TLS_CERT};
    ssl_certificate_key ${TLS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/css text/plain application/javascript application/json image/svg+xml;

    location / {
        proxy_pass ${APP_ORIGIN};
        proxy_http_version 1.1;

        # The app builds absolute links -- the sign-in link above all -- from the Host and scheme it
        # sees, so it has to see the ones the browser used rather than nginx's upstream address.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
